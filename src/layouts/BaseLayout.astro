---
import { Font } from "astro:assets";
import { ClientRouter, fade } from "astro:transitions";

import Footer from "@/components/global/Footer.astro";
import Header from "@/components/global/Header.astro";
import Seo from "@/components/global/Seo.astro";
import { HEADER_TEXT } from "@/content/global";

import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
}

const { title, description, canonical, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="ro" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d0d0d" />
    <Seo title={title} description={description} canonical={canonical} noindex={noindex} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-manrope" preload />
    <ClientRouter />
  </head>
  <body>
    <a
      href="#continut"
      class="fixed top-3 left-gutter z-60 -translate-y-24 rounded-pill bg-paper px-6 py-3 font-medium text-ink focus-visible:translate-y-0"
    >
      {HEADER_TEXT.skipLink}
    </a>
    <Header />
    <main
      id="continut"
      tabindex="-1"
      transition:animate={fade({ duration: "0.3s" })}
      class="outline-none"
    >
      <slot />
    </main>
    <Footer />
    <script>
      import { startAnimations } from "@/scripts/animations";
      import { startCurrentPage } from "@/scripts/navigation/current-page";

      startCurrentPage();
      startAnimations();
    </script>
  </body>
</html>
