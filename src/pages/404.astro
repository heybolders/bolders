---
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import Heading from "@/components/ui/Heading.astro";
import Section from "@/components/ui/Section.astro";
import { ROUTES } from "@/config/navigation";
import { NOT_FOUND_TEXT, SITE } from "@/content/global";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title={`${NOT_FOUND_TEXT.title} | ${SITE.name}`}
  description={NOT_FOUND_TEXT.description}
  noindex
>
  <Section spacing="screen">
    <Container>
      <div class="flex flex-col gap-8">
        <Heading
          as="p"
          size="display"
          weight="light"
          tracking="display"
          tone="muted"
          aria-hidden="true"
        >
          {NOT_FOUND_TEXT.code}
        </Heading>
        <Heading as="h1" size="h2" weight="medium" tracking="tight" split data-anim="line-reveal">
          {NOT_FOUND_TEXT.title}
        </Heading>
        <Container size="text" measure="lead">
          <p class="text-lead text-paper-muted">{NOT_FOUND_TEXT.description}</p>
        </Container>
        <div>
          <Button href={ROUTES.acasa}>{NOT_FOUND_TEXT.cta}</Button>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
