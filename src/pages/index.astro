---
// Pagină de test temporară (Etapa 2): tokeni, font, modulul de animații. Se înlocuiește la Etapa 3.
import BaseLayout from "@/layouts/BaseLayout.astro";

const colors = [
  { name: "ink", className: "bg-ink" },
  { name: "ink-raised", className: "bg-ink-raised" },
  { name: "ink-soft", className: "bg-ink-soft" },
  { name: "surface", className: "bg-surface" },
  { name: "line", className: "bg-line" },
  { name: "mist", className: "bg-mist" },
  { name: "paper", className: "bg-paper" },
  { name: "paper-muted", className: "bg-paper-muted" },
  { name: "paper-dim", className: "bg-paper-dim" },
  { name: "lime", className: "bg-lime" },
  { name: "lime-deep", className: "bg-lime-deep" },
  { name: "lime-shade", className: "bg-lime-shade" },
];

const scale = [
  { name: "text-wordmark", className: "text-wordmark font-light tracking-display" },
  { name: "text-display", className: "text-display font-light tracking-display" },
  { name: "text-story", className: "text-story" },
  { name: "text-h2", className: "text-h2 font-medium tracking-tight" },
  { name: "text-h2-sm", className: "text-h2-sm font-medium" },
  { name: "text-h3", className: "text-h3 font-medium" },
  { name: "text-lead", className: "text-lead" },
  { name: "text-body", className: "text-body" },
  { name: "text-tag", className: "text-tag" },
];

const weights = [
  { value: 200, className: "font-light" },
  { value: 400, className: "font-normal" },
  { value: 500, className: "font-medium" },
  { value: 700, className: "font-bold" },
];

const sample = "ăâîșț ĂÂÎȘȚ Acum este momentul să strălucești!";
---

<BaseLayout
  title="Bolders – test Etapa 2"
  description="Pagină temporară de verificare a tokenilor și a fontului."
  noindex
>
  <main class="mx-auto max-w-site space-y-section px-gutter py-section">
    <header class="space-y-4">
      <p class="text-tag text-paper-muted">Etapa 2 · pagină de test temporară</p>
      <h1 class="text-h2 font-medium tracking-tight">Tokeni, font și modulul de animații</h1>
    </header>

    <section aria-labelledby="paleta" class="space-y-6">
      <h2 id="paleta" class="text-h3 font-medium">
        Paleta
      </h2>
      <ul class="grid grid-cols-2 gap-4 md:grid-cols-4 lg:grid-cols-6">
        {colors.map(({ name, className }) => (
          <li class="space-y-2">
            <div class:list={["aspect-square rounded-card border border-line", className]} />
            <p class="text-tag text-paper-muted">{name}</p>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="scara" class="space-y-6">
      <h2 id="scara" class="text-h3 font-medium">
        Scara tipografică
      </h2>
      <ul class="space-y-8">
        {scale.map(({ name, className }) => (
          <li class="space-y-1 border-t border-line pt-4">
            <p class="text-tag text-paper-muted">{name}</p>
            <p class:list={["break-words", className]}>Bolders</p>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="greutati" class="space-y-6">
      <h2 id="greutati" class="text-h3 font-medium">
        Manrope Variable
      </h2>
      <ul class="space-y-6">
        {weights.map(({ value, className }) => (
          <li class="border-t border-line pt-4">
            <p class="text-tag text-paper-muted">wght {value}</p>
            <p class:list={["text-display tracking-display", className]}>Aa ăâîșț</p>
          </li>
        ))}
      </ul>
      <p class="text-h2 font-medium tracking-tight">{sample}</p>
      <p class="text-lead text-paper-muted">{sample}</p>
    </section>

    <section aria-labelledby="modul" class="space-y-6">
      <h2 id="modul" class="text-h3 font-medium">
        Modulul de animații
      </h2>
      <div data-anim="debug" class="flex items-center gap-3 rounded-pill bg-ink-soft px-8 py-4">
        <span class="size-2 shrink-0 rounded-full bg-lime" aria-hidden="true"></span>
        <p data-anim-item class="text-body" aria-live="polite">
          Modulul de animații nu a pornit
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
