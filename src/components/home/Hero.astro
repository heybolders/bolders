---
import HeroGrid from "@/components/home/HeroGrid.astro";
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import Halo from "@/components/ui/Halo.astro";
import Heading from "@/components/ui/Heading.astro";
import Pill from "@/components/ui/Pill.astro";
import Section from "@/components/ui/Section.astro";
import { HERO, HERO_TITLE } from "@/content/acasa";

// Animații: data-anim="hero-syllables" + "smoke-text" (ANIMATIONS.md, Homepage §1). Fără JS totul e vizibil.
---

{/*
  Excepție documentată (ANIMATIONS.md, „hero-syllables”): scriptul inline rulează înaintea primului paint,
  doar la încărcarea inițială a documentului (la navigarea prin router modulul e deja încărcat și își setează
  singur starea). Hero-ul stă ascuns cel mult până la 1 s de la începutul navigării: dacă modulul nu a ajuns
  până atunci (rețea lentă, eroare), clasa cade și hero-ul rămâne static, ca LCP să nu aștepte după JS.
*/}
<script is:inline>
  (function () {
    const root = document.documentElement;
    if (document.readyState !== "loading") return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    root.classList.add("hero-pending");
    setTimeout(
      function () {
        root.classList.remove("hero-pending");
      },
      Math.max(0, 1000 - performance.now()),
    );
  })();
</script>

<Section data-anim="hero-syllables" spacing="hero" layers clip>
  {/*
    Ca în original: lumina stă pe linia titlului (titlul e la 44–48% din înălțime), deasupra centrului
    blocului de conținut, și sub grilă (în original era fundalul secțiunii, cu liniile peste ea).
  */}
  <Halo position="center" />
  <HeroGrid />

  <Container>
    <div class="flex flex-col items-center text-center">
      <Pill data-hero-part="pill">{HERO.pill}</Pill>

      {/*
      Numele accesibil vine din aria-label; textul rămâne în HTML (SEO), iar partea vizuală, împărțită
      în silabe și apoi în litere de smoke-text, e aria-hidden. Letter-spacing normal, ca în original.
    */}
      <Heading as="h1" size="display" aria-label={HERO_TITLE} class="mt-8 md:mt-10">
        <span aria-hidden="true" class="block">
          {/* flow-root: marginile negative ale măștii SplitText (.line-mask) nu colapsează prin titlu (CLS) */}
          <span data-hero-part="line" class="flow-root font-bold text-balance">
            {HERO.title.light}
          </span>
          <span class="block font-bold">
            {/* masca intrării (clip-path) o pune modulul doar cât rulează intrarea */}
            <span data-hero-part="word" class="line-mask inline-block">
              <span data-hero-syllable class="inline-block">
                {HERO.title.bold}
              </span>
            </span>{" "}
            {/* nowrap: cuvântul nu se rupe; fumul (data-anim="smoke-text") rulează pe litere după intrare */}
            <span
              data-hero-part="word"
              data-anim="smoke-text"
              class="line-mask no-kerning inline-block whitespace-nowrap"
            >
              {HERO.title.syllables.map((syllable) => (
                <span data-hero-syllable class="inline-block">
                  {syllable}
                </span>
              ))}
            </span>
          </span>
        </span>
      </Heading>

      <Container size="text" measure="lead" class="mt-8 md:mt-10">
        <p data-hero-part="after" class="text-lead text-balance text-paper-muted">
          {HERO.subtitle}
        </p>
      </Container>

      <div data-hero-part="after" class="mt-10 md:mt-12">
        <Button href={HERO.cta.href}>{HERO.cta.label}</Button>
      </div>
    </div>
  </Container>
</Section>
