---
import Container from "@/components/ui/Container.astro";

// Fundalul hero-ului (DESIGN §3.4): liniile de construcție ale lui „b” desenate pe grila reală.
// Verticalele sunt marginile coloanelor din container-site (4 pe mobil, 12 de la md); cercul și
// diagonalele stau într-un pătrat care acoperă coloane întregi, deci tangentele lui cad pe linii de coloană.
const COLUMNS = 12;
---

<div class="hero-grid pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
  <Container fill>
    <div class="relative grid h-full grid-cols-4 md:grid-cols-12">
      {Array.from({ length: COLUMNS }, (_, index) => (
        <div
          class:list={[
            "row-start-1 border-l border-dashed border-line",
            index >= 4 && "max-md:hidden",
            // ultima coloană vizibilă închide grila
            index === 3 && "max-md:border-r",
            index === COLUMNS - 1 && "border-r",
          ]}
        />
      ))}

      {/* grilă suprapusă: pătratul ocupă coloane întregi fără să împingă liniile de coloană */}
      <div class="absolute inset-0 grid grid-cols-4 md:grid-cols-12">
        <div class="relative col-span-4 col-start-1 aspect-square self-center md:col-span-6 md:col-start-4">
          {/* ghidajele orizontale ale lui „b”: vârful tijei, umărul burții, linia de bază */}
          <div class="absolute top-0 left-1/2 w-screen -translate-x-1/2 border-t border-dashed border-line" />
          <div class="absolute top-1/3 left-1/2 w-screen -translate-x-1/2 border-t border-dashed border-line" />
          <div class="absolute bottom-0 left-1/2 w-screen -translate-x-1/2 border-t border-dashed border-line" />

          <svg
            viewBox="0 0 100 100"
            class="absolute inset-0 size-full overflow-visible fill-none stroke-line"
            focusable="false"
          >
            <circle cx="50" cy="50" r="50" vector-effect="non-scaling-stroke" />
            {/* diagonalele paralele ale construcției (≈ 56°), a doua tangentă la cerc */}
            <line
              x1="-10"
              y1="-90"
              x2="110"
              y2="90"
              stroke-dasharray="6 6"
              vector-effect="non-scaling-stroke"
            />
            <line
              x1="17"
              y1="-90"
              x2="157"
              y2="120"
              stroke-dasharray="6 6"
              vector-effect="non-scaling-stroke"
            />
          </svg>
        </div>
      </div>
    </div>
  </Container>
</div>
