---
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import Icon from "@/components/ui/Icon.astro";
import Pill from "@/components/ui/Pill.astro";
import TextLink from "@/components/ui/TextLink.astro";
import { HEADER_CTA, PRIMARY_NAV, ROUTES, normalizePath } from "@/config/navigation";
import { HEADER_TEXT } from "@/content/global";

// Persistent între pagini: aria-current se actualizează și pe client (scripts/navigation/current-page.ts).
const current = normalizePath(Astro.url.pathname);
const ariaCurrent = (href: string) => (normalizePath(href) === current ? "page" : undefined);
// data-* fără valoare se scriu ="" pe primitive: trecute prin props, ar ajunge în HTML ca ="true"
---

<header
  data-anim="nav"
  transition:persist="header"
  transition:name="header"
  class="fixed inset-x-0 top-0 z-50"
>
  <div data-nav-bar class="relative z-10 pt-3 md:pt-4">
    <Container>
      <Pill as="div" variant="bar">
        <div class="lg:flex-1">
          <TextLink
            href={ROUTES.acasa}
            variant="logo"
            data-nav-logo=""
            aria-label={HEADER_TEXT.logoLabel}
          >
            <span data-nav-logo-mark class="block">
              <Icon name="logo" />
            </span>
          </TextLink>
        </div>

        <nav aria-label={HEADER_TEXT.navLabel} class="hidden lg:block">
          <Pill as="ul" variant="glass">
            {PRIMARY_NAV.map(({ href, label }) => (
              <li>
                <TextLink
                  href={href}
                  variant="nav"
                  data-nav-link=""
                  aria-current={ariaCurrent(href)}
                >
                  {label}
                </TextLink>
              </li>
            ))}
          </Pill>
        </nav>

        <div class="hidden justify-end lg:flex lg:flex-1">
          <Button variant="header" href={HEADER_CTA}>
            {HEADER_TEXT.cta}
          </Button>
        </div>

        <Button
          variant="icon"
          data-nav-toggle=""
          aria-expanded="false"
          aria-controls="meniu-mobil"
          aria-label={HEADER_TEXT.menuToggle}
          class="lg:hidden"
        >
          <Icon name="menu" />
        </Button>
      </Pill>
    </Container>
  </div>

  <div id="meniu-mobil" data-nav-menu hidden class="fixed inset-0 bg-ink lg:hidden">
    <nav
      aria-label={HEADER_TEXT.menuToggle}
      class="flex h-full flex-col justify-end px-gutter pt-24 pb-section"
    >
      <ul class="space-y-1">
        {PRIMARY_NAV.map(({ href, label }) => (
          <li class="-mx-2 overflow-clip px-2">
            <TextLink
              href={href}
              variant="menu"
              data-nav-link=""
              data-anim-item=""
              aria-current={ariaCurrent(href)}
            >
              {label}
            </TextLink>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
