---
// Lumină difuză statică în spatele textelor (DESIGN.md §7): gradient radial din tokeni, la intensitatea
// originalului, fără animație (decizie Adi, pentru performanță). Părintele trebuie să fie
// `relative isolate overflow-clip` (Section cu `layers` + `clip`): haloul e mai lat decât ecranul pe mobil,
// iar clip-ul pe secțiune (nu pe body) oprește scroll-ul orizontal. Centrul haloului stă în punctul de
// ancoră; în DOM se pune înaintea celorlalte straturi decorative, ca să rămână sub ele. Docs: docs/COMPONENTS.md.
const POSITIONS = {
  center: "top-1/2 left-1/2",
  top: "top-1/4 left-1/2",
  bottom: "top-3/4 left-1/2",
  left: "top-1/2 left-1/4",
  right: "top-1/2 left-3/4",
} as const;

type Position = keyof typeof POSITIONS;

interface Props {
  position?: Position;
  /** false: haloul lipsește sub md (mai puține halouri pe mobil) */
  mobile?: boolean;
  /** doar poziționare în layout (margin, grid, order) */
  class?: string;
}

const { position = "center", mobile = true, class: className } = Astro.props;
---

{/* profil apropiat de lumina originală: 50% la un sfert din rază, 0 la marginea elementului (70% din colț) */}
<div
  aria-hidden="true"
  class:list={[
    "pointer-events-none absolute -z-10 size-halo -translate-x-1/2 -translate-y-1/2 bg-radial from-halo via-halo/50 via-18% to-transparent to-70% md:size-halo-lg",
    POSITIONS[position],
    !mobile && "max-md:hidden",
    className,
  ]}
></div>
