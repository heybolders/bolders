---
import type { HTMLAttributes } from "astro/types";

// Randează <a> când primește href, altfel <button>. Docs: docs/COMPONENTS.md.
// Variantele pill au punctul lime, umplerea din punct (.btn / .btn-fill în global.css) și glow-ul static
// (shadow-glow, halou pe tot conturul ca pill-ul din hero-ul original, neschimbat la hover/active).
// Punctul rămâne lime: la hover/focus se pierde în umplerea lime, la apăsare (:active) devine ink.
// header: compact, peste blur · cta: mare, în pagini · footer: lățime plină pe mobil (formular, Etapa 6)
// icon: fără chenar, punct sau glow; ținta de 44 px pentru o iconiță (toggle-ul meniului)
// data-cursor: starea cursorului custom la hover (cursor.ts, delegare pe document)
const VARIANTS = {
  header: "min-h-11 bg-ink-soft/50 text-lead backdrop-blur-nav",
  cta: "btn-lg min-h-14 bg-ink-soft text-lead",
  footer: "btn-lg min-h-14 w-full bg-ink-soft text-body sm:w-auto",
  icon: "flex size-11 items-center justify-center rounded-pill",
} as const;

type Variant = keyof typeof VARIANTS;

const PILL =
  "btn relative isolate inline-flex items-center justify-center gap-3 overflow-clip rounded-pill border border-line font-medium text-paper shadow-glow";
// același inel ca :focus-visible din layer-ul base, legat explicit de primitivă
const FOCUS = "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lime";

interface Props extends Omit<HTMLAttributes<"button">, "class" | "type"> {
  variant?: Variant;
  href?: string;
  type?: HTMLAttributes<"button">["type"];
  /** doar poziționare în layout (margin, grid, order, vizibilitate pe breakpoint) */
  class?: string;
}

const { variant = "cta", href, type = "button", class: className, ...attrs } = Astro.props;

const isPill = variant !== "icon";
const Tag = href ? "a" : "button";
---

<Tag
  data-cursor="button"
  {...attrs}
  href={href}
  type={href ? undefined : type}
  class:list={["group", isPill && PILL, VARIANTS[variant], FOCUS, className]}
>
  {isPill ? (
    <>
      <span class="btn-fill absolute inset-0 -z-10 bg-lime" aria-hidden="true" />
      <span class="size-2 shrink-0 rounded-pill bg-lime group-active:bg-ink" aria-hidden="true" />
      <span class="transition-colors duration-400 group-hover:text-ink group-focus-visible:text-ink motion-reduce:transition-none">
        <slot />
      </span>
    </>
  ) : (
    <slot />
  )}
</Tag>
